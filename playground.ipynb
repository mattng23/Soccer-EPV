    "# Load in libraries and match data\n",
    "\n",
    "import json\n",
    "import pandas as pd\n",
    "\n",
    "with open(\"Single Match Data.json\", \"r\", encoding=\"utf-8\") as f:\n",
    "    data = json.load(f)\n",
    "\n",
    "df = pd.json_normalize(data)\n"
   ]
